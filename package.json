{
  "name": "metric-scraper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TikTok and Instagram public engagement metric snapshot pipeline.",
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "scraper": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "cli": "tsx src/cli/index.ts",
    "diagnose:proxy": "tsx scripts/proxy-validation-diagnostic.ts",
    "compare:tiktok-apify": "tsx scripts/compare-tiktok-apify.ts",
    "build": "pnpm run build:server && pnpm run build:web",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "commander": "^14.0.0",
    "dotenv": "^17.0.0",
    "p-queue": "^8.1.0",
    "pino": "^9.6.0",
    "undici": "^7.16.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^16.2.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
