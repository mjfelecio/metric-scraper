# Copy to .env and adjust. Never commit a real .env.
# Every value below has a safe default in src/config/env.ts; nothing here is required.

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# trace | debug | info | warn | error | fatal | silent
# Structured logs are written to stderr so stdout stays clean for machine output.
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Throughput
# ---------------------------------------------------------------------------
# Number of scrape jobs allowed to be in flight at once.
SCRAPER_CONCURRENCY=10
# Target requests per minute for the whole process. The queue paces itself to
# this ceiling; the acceptance target for the finished system is 500 rpm.
SCRAPER_TARGET_RPM=500
# Hard cap on queued (not yet started) jobs. 0 = unbounded.
SCRAPER_MAX_QUEUE_SIZE=0
# Per-request timeout applied by the HTTP client.
SCRAPER_REQUEST_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Retry policy (exponential backoff)
# ---------------------------------------------------------------------------
# Total attempts per URL, including the first one. 1 disables retries.
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY_MS=250
RETRY_MAX_DELAY_MS=10000
RETRY_BACKOFF_FACTOR=2
# Full jitter on the backoff delay. Recommended for high-concurrency runs.
RETRY_JITTER=true

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------
# Append-only JSONL snapshots and run summaries are written here.
OUTPUT_DIR=./output

# ---------------------------------------------------------------------------
# Proxies
# ---------------------------------------------------------------------------
# Comma- or newline-separated list of proxy URLs. Empty = direct connection.
# Fetch transport format: protocol://[user:pass@]host:port  (http or https)
# Example (do NOT commit real credentials):
#   PROXY_POOL=http://user:pass@proxy-a.example.net:8000,http://user:pass@proxy-b.example.net:8000
PROXY_POOL=
# Consecutive failures before a proxy is put in cooldown.
PROXY_MAX_FAILURES=3
# How long a failed/blocked proxy stays out of rotation.
PROXY_COOLDOWN_MS=60000

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
# Path to a JSON file holding platform sessions/cookies, if the acquisition
# mechanism turns out to need them. Empty = run without sessions (the default).
# The file is gitignored; see README for the expected shape.
SESSION_STORE_PATH=
# Consecutive failures before a session is marked blocked.
SESSION_MAX_FAILURES=3
SESSION_COOLDOWN_MS=300000

# ---------------------------------------------------------------------------
# Instagram volatile first-party operations
# ---------------------------------------------------------------------------
# Instagram retires these undocumented document IDs without notice. Keep the
# last verified defaults unless a live response reports an invalid operation.
INSTAGRAM_POST_DOC_ID=27128499623469141
INSTAGRAM_CLIPS_DOC_ID=27234427476213202
INSTAGRAM_CLIPS_MAX_PAGES=2
INSTAGRAM_CLIPS_MAX_AUTHORS=3
