# Copy to .env and adjust. Never commit a real .env.
# Every value below has a safe default in src/config/env.ts; nothing here is required.

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# trace | debug | info | warn | error | fatal | silent
# Structured logs are written to stderr so stdout stays clean for machine output.
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Throughput
# ---------------------------------------------------------------------------
# Number of scrape jobs allowed to be in flight at once. This is a CEILING, not
# a target: sustained throughput is concurrency / latency, so reaching 500 rpm
# at a 3.5s mean latency needs roughly 30, not 10. See README section 5.1.
SCRAPER_CONCURRENCY=10
# Logical scrape jobs admitted per minute. One URL is one unit, whatever it
# costs in retries or hops. This is the figure the run summary reports and the
# acceptance target is written against. 0 disables pacing.
SCRAPER_TARGET_RPM=500
# Jobs admissible at once after an idle period. 0 = one second of SCRAPER_TARGET_RPM.
# Burst is what lets a small batch reach the concurrency ceiling promptly.
SCRAPER_BURST=0
# Ceiling on ACTUAL outbound HTTP requests per minute, per host — retries and
# multi-hop platform calls included. SCRAPER_TARGET_RPM does not protect upstream,
# because one job can be several requests (TikTok issues two). 0 disables.
SCRAPER_HTTP_RPM_PER_HOST=0
# Max jobs waiting (not yet started). When full, the producer waits rather than
# failing, which is what bounds memory on a large input. 0 = unbounded.
SCRAPER_MAX_QUEUE_SIZE=1000
# Maximum time for each individual outbound HTTP request. Every request in a
# multi-hop scrape receives a fresh budget.
SCRAPER_REQUEST_TIMEOUT_MS=15000
# Maximum time for one complete platform attempt, including every sequential
# request in that attempt. TikTok normally needs two requests; Instagram can
# need up to eight while resolving collaboration posts and Reel metrics.
TIKTOK_ATTEMPT_TIMEOUT_MS=15000
INSTAGRAM_ATTEMPT_TIMEOUT_MS=60000
# Default gap between cycle starts in a continuous run (--watch). Content
# Rewards polls every 15 minutes; lower it to exercise the same code path in
# seconds during testing. 0 = back-to-back cycles, which is what sustains a
# target rpm continuously.
SCRAPER_POLL_INTERVAL_MS=900000

# ---------------------------------------------------------------------------
# Retry policy (exponential backoff)
# ---------------------------------------------------------------------------
# Total attempts per URL, including the first one. 1 disables retries.
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY_MS=250
RETRY_MAX_DELAY_MS=10000
RETRY_BACKOFF_FACTOR=2
# Full jitter on the backoff delay. Recommended for high-concurrency runs.
RETRY_JITTER=true

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------
# Append-only JSONL snapshots and run summaries are written here.
OUTPUT_DIR=./output

# ---------------------------------------------------------------------------
# Proxies
# ---------------------------------------------------------------------------
# Comma- or newline-separated list of proxy URLs. Empty = direct connection.
# Fetch transport format: protocol://[user:pass@]host:port  (http or https)
# Example (do NOT commit real credentials):
#   PROXY_POOL=http://user:pass@proxy-a.example.net:8000,http://user:pass@proxy-b.example.net:8000
PROXY_POOL=
# Consecutive failures before a proxy is put in cooldown.
PROXY_MAX_FAILURES=3
# How long a failed/blocked proxy stays out of rotation.
PROXY_COOLDOWN_MS=60000
# The most jobs any one proxy may hold at a time. 0 = unlimited sharing.
# A ceiling, not an allocation: a proxy doubles its slots with each success up
# to this and halves them with each failure, so proxies x limit is the pool's
# MAXIMUM capacity and proxies.capacity in the run summary is what has actually
# been earned. That earned figure is the one to compare SCRAPER_CONCURRENCY
# against. Raise this if the pool is consistently the binding constraint.
PROXY_MAX_CONCURRENT=8
# The floor every proxy starts at and can be pushed back down to. Health is only
# checked when a lease is handed out, so this is what bounds how many jobs a dead
# IP can absorb before its first failure comes back; a proxy that has never
# succeeded never leaves it. Raise it only if the ramp-up at the start of a run
# is too slow for your pool.
PROXY_PROBATION_CONCURRENT=1
# One lease in this many is reserved for a proxy that has never succeeded.
# 0 disables exploration. Without a reserved share a proxy needs a success to be
# preferred but is scheduled last, so it never gets the traffic that would earn
# one — and a large pool behaves like whichever two proxies worked first. The
# cost is bounded twice over: at most 1/N of leases, and at most
# PROXY_MAX_FAILURES requests per bad proxy before it cools out.
PROXY_EXPLORATION_PERIOD=5
# Undici's own connect-phase timeout per proxy dispatcher. Undici defaults to
# 10s if this is unset, which is well past what's needed to declare a dead
# proxy unreachable and fires before SCRAPER_REQUEST_TIMEOUT_MS ever does.
# Must be less than SCRAPER_REQUEST_TIMEOUT_MS.
PROXY_CONNECT_TIMEOUT_MS=3000
# How long a job waits for a proxy before its attempt fails. Only ever spent
# when waiting can help — a cooldown about to expire, or a source with
# candidates left to admit — so a burst of evictions costs a few seconds of
# latency instead of failing every job in flight. 0 = fail immediately.
PROXY_ACQUIRE_WAIT_MS=5000

# --- Dynamic proxy source --------------------------------------------------
# A live supply of CANDIDATE proxies, layered on top of PROXY_POOL rather than
# replacing it. Candidates are TCP-probed, and survivors join the same pool the
# static list uses; the existing health/probation system still decides which of
# them are actually usable. Empty = disabled.
# ProxyScrape's text endpoint carries exactly what is needed (protocol/ip/port):
#   https://api.proxyscrape.com/v4/free-proxy-list/get?request=display_proxies&proxy_format=protocolipport&format=text&protocol=http
PROXY_SOURCE_URL=
# How often the candidate list is refetched. A stale list is not an emergency:
# a failed refresh keeps running on the candidates already held.
PROXY_SOURCE_REFRESH_MS=900000
# Usable CAPACITY to aim for, in concurrent slots — the same unit as
# SCRAPER_CONCURRENCY, not a proxy count. A proxy that has never succeeded is
# worth one slot and a benched one is worth none, so a roster of dead proxies
# can no longer report a pool at full strength. Leave at 0 to follow
# SCRAPER_CONCURRENCY, which is the only setting under which the two cannot
# silently disagree.
PROXY_SOURCE_TARGET_CAPACITY=0
# Startup blocks until this much capacity exists, NOT until TARGET_CAPACITY.
# Free lists often cannot reach the target at all, and waiting for one they
# can't meet would just stall the run. This doubles as the eviction floor: the
# roster is never reaped below this many entries that could still come back.
PROXY_SOURCE_MIN_CAPACITY=5
# Simultaneous validation probes. This is the knob that stops a list of several
# thousand proxies turning into several thousand concurrent connections.
PROXY_SOURCE_VALIDATE_CONCURRENCY=10
# Budget for one whole validation probe: reach the proxy, open a CONNECT tunnel
# to a neutral endpoint, complete a TLS handshake and read one response. Must be
# greater than PROXY_CONNECT_TIMEOUT_MS, which is the connect phase inside it —
# below that, every candidate fails at the stage after connect and the pool
# starves. Do not raise it far above the production budget either: a probe more
# patient than a real request certifies proxies the request will then reject.
PROXY_SOURCE_VALIDATE_TIMEOUT_MS=5000
# Ceiling on remembered candidates, so a huge list cannot grow without bound.
PROXY_SOURCE_MAX_CANDIDATES=5000

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
# Path to a JSON file holding platform sessions/cookies, if the acquisition
# mechanism turns out to need them. Empty = run without sessions (the default).
# The file is gitignored; see README for the expected shape.
SESSION_STORE_PATH=
# Consecutive failures before a session is marked blocked.
SESSION_MAX_FAILURES=3
SESSION_COOLDOWN_MS=300000

# ---------------------------------------------------------------------------
# Instagram volatile first-party operations
# ---------------------------------------------------------------------------
# Instagram retires these undocumented document IDs without notice. Keep the
# last verified defaults unless a live response reports an invalid operation.
INSTAGRAM_POST_DOC_ID=27128499623469141
INSTAGRAM_CLIPS_DOC_ID=27234427476213202
INSTAGRAM_CLIPS_MAX_PAGES=2
INSTAGRAM_CLIPS_MAX_AUTHORS=3

# --- Bandwidth measurement --------------------------------------------------
# Counts real wire bytes per request in an undici dispatcher interceptor and
# feeds the dashboard's Bandwidth panel. Measured at the dispatcher rather than
# at the HTTP client because the client only sees a decompressed body, and
# proxies bill compressed bytes — roughly a 5:1 difference on HTML.
# Overhead is summing chunk lengths. Set to false to disable the panel.
METRICS_BANDWIDTH=true
